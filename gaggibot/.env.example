# Required: Discord application bot token and one or more Discord user IDs.
DISCORD_BOT_TOKEN=replace-me
DISCORD_USER_IDS=123456789012345678
# Required: long random value also configured in GaggiMate.
GAGGIBOT_SHARED_TOKEN=replace-with-at-least-32-random-characters

# Both the published host port and the container port (default 3000).
GAGGIBOT_PORT=3000
# Only used when running the image without compose; under Portainer GAGGIBOT_PORT sets both.
PORT=3000
DATA_DIR=/data
LOG_LEVEL=info

# Optional OpenAI-compatible parsing. Leave AI_URL empty for deterministic parsing.
AI_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Local testing only: run without a Discord account. Messages are recorded instead of sent and
# the /api/v1/_dev/* harness endpoints are enabled. NEVER set this in a real deployment.
# GAGGIBOT_DRY_RUN=1
