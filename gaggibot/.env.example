# Required: Discord application bot token and one or more Discord user IDs.
DISCORD_BOT_TOKEN=replace-me
DISCORD_USER_IDS=123456789012345678
# Required: long random value also configured in GaggiMate.
GAGGIBOT_SHARED_TOKEN=replace-with-at-least-32-random-characters

PORT=3000
DATA_DIR=/data
LOG_LEVEL=info

# Optional OpenAI-compatible parsing. Leave AI_URL empty for deterministic parsing.
AI_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini
